rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validActivity(data) {
      return data.keys().hasAll(['taskId', 'taskName', 'taskDescription', 'category', 'configuredPoints', 'timestamp', 'note', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['taskId', 'taskName', 'taskDescription', 'category', 'configuredPoints', 'timestamp', 'note', 'createdAt', 'updatedAt'])
        && data.taskId is string && data.taskId.size() > 0
        && data.taskName is string && data.taskName.size() > 0
        && data.taskDescription is string
        && data.category in ['growth', 'people', 'life', 'play']
        && data.configuredPoints is number && data.configuredPoints > 0
        && data.timestamp is string && data.timestamp.size() > 0
        && data.note is string && data.note.size() <= 2000
        && data.createdAt is string && data.updatedAt is string;
    }
    function validTask(data) {
      return data.keys().hasAll(['category', 'name', 'description', 'points', 'icon', 'note', 'order', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['category', 'name', 'description', 'points', 'weeklyLimit', 'icon', 'note', 'order', 'createdAt', 'updatedAt'])
        && data.category in ['growth', 'people', 'life', 'play']
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.description is string && data.description.size() <= 1000
        && data.points is number && data.points > 0
        && (!data.keys().hasAny(['weeklyLimit']) || data.weeklyLimit == null || (data.weeklyLimit is int && data.weeklyLimit >= 1 && data.weeklyLimit <= 999))
        && data.icon is string && data.icon.size() > 0
        && data.note is string && data.note.size() <= 2000
        && data.order is number && data.order >= 0
        && data.createdAt is string && data.updatedAt is string;
    }
    function validTaskUsage(data) {
      return data.keys().hasAll(['taskId', 'weekKey', 'count', 'updatedAt'])
        && data.keys().hasOnly(['taskId', 'weekKey', 'count', 'updatedAt'])
        && data.taskId is string && data.taskId.size() > 0
        && data.weekKey is string && data.weekKey.size() > 0
        && data.count is int && data.count >= 0
        && data.updatedAt is string;
    }
    match /users/{uid}/activities/{activityId} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validActivity(request.resource.data);
      allow update: if owner(uid) && validActivity(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note', 'updatedAt']);
      allow delete: if owner(uid);
    }
    match /users/{uid}/tasks/{taskId} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validTask(request.resource.data);
      allow update: if owner(uid) && validTask(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['category', 'name', 'description', 'points', 'weeklyLimit', 'icon', 'note', 'updatedAt']);
      allow delete: if owner(uid);
    }
    match /users/{uid}/taskUsage/{usageId} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validTaskUsage(request.resource.data);
      allow update: if owner(uid) && validTaskUsage(request.resource.data)
        && request.resource.data.taskId == resource.data.taskId
        && request.resource.data.weekKey == resource.data.weekKey;
    }
    match /users/{uid}/settings/taskList {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['seedVersion', 'createdAt'])
        && request.resource.data.seedVersion == 1
        && request.resource.data.createdAt is string;
    }
    match /users/{uid}/docs/{entityId} {
      allow read: if owner(uid);
      allow write: if false;
      match /edits/{editId} {
        allow read: if owner(uid);
        allow write: if false;
      }
    }
    match /users/{uid}/docOperations/{operationId} {
      allow read, write: if false;
    }
    match /users/{uid}/aiProposals/{proposalId} {
      allow read, write: if false;
    }
    match /users/{uid}/aiRequests/{requestId} {
      allow read, write: if false;
    }
    match /users/{uid}/aiApprovals/{approvalId} {
      allow read, write: if false;
    }
    match /users/{uid}/aiConversations/{conversationId} {
      allow read, write: if false;
    }
  }
}
